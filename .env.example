# Скопируйте в .env на сервере и заполните. Файл .env в git не попадает.
SITE_DOMAIN=example.ru
ADMIN_DOMAIN=admin.example.ru
# Публичный адрес админ-панели (с https://). Без домена, для теста по IP: http://IP:8081
CMS_PUBLIC_URL=https://admin.example.ru
POSTGRES_DB=quality
POSTGRES_USER=quality
POSTGRES_PASSWORD=change-me-long-random
# CMS (Directus)
CMS_SECRET=change-me-long-random
ADMIN_EMAIL=admin@example.ru
ADMIN_PASSWORD=change-me-long
# токен администратора для служебных скриптов (openssl rand -hex 24); хранится только в .env на сервере
CMS_ADMIN_TOKEN=change-me-random-token
# токен чтения для сайта: любая длинная случайная строка (openssl rand -hex 24)
DIRECTUS_TOKEN=change-me-random-token
# Резервные копии (restic, отдельное S3-хранилище)
RESTIC_REPOSITORY=s3:https://s3.example.ru/quality-backups
RESTIC_PASSWORD=change-me-store-offline-too
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
